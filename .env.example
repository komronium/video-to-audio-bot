# ── Bot (required) ──────────────────────────────────────
BOT_TOKEN=123456:your-bot-token-from-botfather
CHANNEL_ID=-1001234567890
GROUP_ID=-1001234567890
ADMIN_ID=123456789

# ── Optional ────────────────────────────────────────────
CHANNEL_JOIN_LINK=https://t.me/your_channel
DATABASE_URL=sqlite+aiosqlite:///./database.db

# ── Local telegram-bot-api (required to run the bot-api server) ──
# Get these once at https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
